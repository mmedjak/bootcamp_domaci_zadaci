-- 1. Za sezonu 2024/25 prikažite igrače i ukupan broj golova koje su postigli. Prikažite samo igrače koji su postigli bar jedan gol.
-- Pomoću DENSE_RANK() rangirajte igrače prema ukupnom broju golova, od najvećeg ka najmanjem. Igrači sa istim brojem golova treba da imaju isti rang.

SELECT
    e.player_id,
    p.first_name, p.last_name,
    count (e.event_id) AS total_goals,
    DENSE_RANK() OVER (ORDER BY count (e.event_id) DESC) AS drnk
FROM match_events e
JOIN matches m ON m.match_id = e.match_id
JOIN players p ON p.player_id = e.player_id
WHERE m.season = '2024/25'
    AND e.event_type IN ('goal', 'penalty_goal')
GROUP BY e.player_id, p.first_name, p.last_name
;


-- 2. Za sezonu 2024/25 prikažite tri igrača sa najviše postignutih golova za svaki klub.
-- Prikažite naziv kluba, ime i prezime igrača i broj postignutih golova. Pomoću ROW_NUMBER() odredite redosled igrača unutar svakog kluba, od najvećeg ka najmanjem broju golova.


SELECT
   -- e.player_id, e.team_id,
    t.team_name, p.first_name, p.last_name, 
    count (e.event_id) AS goals
FROM match_events e
JOIN matches m 
        ON m.match_id = e.match_id
JOIN players p 
        ON p.player_id = e.player_id
JOIN teams t 
        ON t.team_id = e.team_id
WHERE m.season = '2024/25'
GROUP BY -- e.team_id, e.player_id, 
        p.first_name, p.last_name, t.team_name
ORDER BY goals DESC
;

-- Kingsbridge City	    Mattéo	O'Brien	    40
-- Northport United	    Leo	Marsh	        38
-- Elmsworth Wanderers	Marko	Stanković	33


SELECT
    -- e.player_id, e.team_id,
    t.team_name, p.first_name, p.last_name, 
    count (e.event_id) AS goals,
    ROW_NUMBER () OVER (PARTITION BY t.team_name ORDER BY count(e.event_id) DESC) AS rn
FROM match_events e
JOIN matches m ON m.match_id = e.match_id
JOIN players p ON p.player_id = e.player_id
JOIN teams t ON t.team_id = e.team_id
WHERE m.season = '2024/25'
GROUP BY -- e.team_id, e.player_id, 
        t.team_name, p.first_name, p.last_name
QUALIFY rn <= 3
ORDER BY goals DESC
;

